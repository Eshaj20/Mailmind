# Copy this file to .env.selfhosted. Do not commit .env.selfhosted.
ENVIRONMENT=selfhosted

# Generate unique, private values before your first launch.
POSTGRES_USER=mailmind
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=mailmind
DATABASE_URL=postgresql+psycopg://mailmind:replace-with-a-long-random-database-password@postgres:5432/mailmind
SECRET_KEY=replace-with-a-random-32-plus-character-secret

# The self-hosted web application is always local. No tunnel or Vercel URL is used.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_APP_URL=http://localhost:8080

# Create your own Google OAuth client and add this exact redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify
GMAIL_INITIAL_SYNC_MAX_RESULTS=25
GMAIL_SYNC_QUERY=newer_than:30d

# Optional: leave blank to use MailMind's deterministic local fallback for ambiguous emails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: required only for email-based password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SYNC_JOB_MAX_ATTEMPTS=3
API_RATE_LIMIT_PER_MINUTE=120
