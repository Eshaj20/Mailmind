PROJECT_NAME=MailMind
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
SECRET_KEY=replace-with-random-32-plus-character-secret
CORS_ORIGINS=https://your-frontend-domain.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/api/v1/gmail/oauth/callback
GMAIL_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify
GMAIL_INITIAL_SYNC_MAX_RESULTS=25
GMAIL_SYNC_QUERY=newer_than:30d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_1M_TOKENS=0.0
OPENAI_OUTPUT_COST_PER_1M_TOKENS=0.0
CLASSIFICATION_RULE_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_BATCH_LIMIT=200
SPAM_SCORE_THRESHOLD=0.7
SPAM_HIGH_RISK_THRESHOLD=0.85
SPAM_MODEL_PATH=
SPAM_MODEL_VERSION=pretrained-spam-v1

REDIS_URL=redis://USER:PASSWORD@HOST:6379
CELERY_BROKER_URL=redis://USER:PASSWORD@HOST:6379
CELERY_RESULT_BACKEND=redis://USER:PASSWORD@HOST:6379
SYNC_JOB_MAX_ATTEMPTS=3
API_RATE_LIMIT_PER_MINUTE=120
