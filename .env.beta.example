PROJECT_NAME=MailMind
ENVIRONMENT=production
# Copy the complete Session pooler URL from Supabase Connect (port 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=https://mailmind-gray-omega.vercel.app
FRONTEND_APP_URL=https://mailmind-gray-omega.vercel.app
# Optional controlled-beta allowlist. Keep empty only after you are ready for
# unrestricted account creation. Example: founder@example.com,tester@example.com
BETA_ALLOWED_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://replace-after-tunnel-starts.trycloudflare.com/api/v1/gmail/oauth/callback
GMAIL_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify

# Required to deliver password-reset links. For a small closed beta, use a dedicated
# SMTP mailbox; do not commit its password or use your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
GMAIL_INITIAL_SYNC_MAX_RESULTS=25
GMAIL_SYNC_QUERY=newer_than:30d
OAUTH_STATE_EXPIRE_MINUTES=10

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_1M_TOKENS=0.0
OPENAI_OUTPUT_COST_PER_1M_TOKENS=0.0
CLASSIFICATION_RULE_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_BATCH_LIMIT=200
SPAM_SCORE_THRESHOLD=0.7
SPAM_HIGH_RISK_THRESHOLD=0.85
SPAM_MODEL_PATH=
SPAM_MODEL_VERSION=pretrained-spam-v1

SYNC_JOB_MAX_ATTEMPTS=3
SYNC_RETRY_BASE_SECONDS=5
SYNC_RETRY_MAX_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120
