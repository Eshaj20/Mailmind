PROJECT_NAME=MailMind
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://mailmind:mailmind@postgres:5432/mailmind
SECRET_KEY=replace-with-a-random-32-plus-character-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GMAIL_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.modify
GMAIL_INITIAL_SYNC_MAX_RESULTS=25

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFICATION_RULE_CONFIDENCE_THRESHOLD=0.75
CLASSIFICATION_BATCH_LIMIT=200
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SYNC_JOB_MAX_ATTEMPTS=3
API_RATE_LIMIT_PER_MINUTE=120